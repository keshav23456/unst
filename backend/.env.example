# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/eventx
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventx
MONGO_URI=mongodb://127.0.0.1:27017/eventx

# ── JWT ───────────────────────────────────────────────────
# Use long random strings in real deployments, e.g.: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRY=10d

# ── Admin bootstrap ────────────────────────────────────────
# The account with this email becomes an admin on its next login (and on
# signup, if it doesn't exist yet). Register/log in with it right after
# deploying so nobody else can claim it. Admins can then promote others.
ADMIN_EMAIL=you@example.com

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Local dev:  http://localhost:5173
# Production: https://your-frontend.vercel.app
# Leave unset to fall back to the built-in defaults in app.js.
CORS_ORIGINS=http://localhost:5173

# ── Cookies ───────────────────────────────────────────────
# Leave unset for local dev — the browser infers the domain from the
# request host. Only set this in production if you need cookies shared
# across subdomains (e.g. ".yourapp.com").
# COOKIE_DOMAIN=

# ── Cloudinary ────────────────────────────────────────────
# https://cloudinary.com/console — free tier is fine for dev
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
